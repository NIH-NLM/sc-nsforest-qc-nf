// Resource limits for a GitHub Actions runner (4 CPUs, 16 GB). Use with: -c configs/ci.config
// The production requests in nextflow.config (32 CPUs, 384 GB and more) exceed a runner.
process {
    withName: '.*_process' {
        cpus          = 2
        memory        = '6 GB'
        maxForks      = 2
        maxRetries    = 0
        errorStrategy = 'terminate'
    }
}
