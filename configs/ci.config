// Settings for a GitHub Actions runner (4 CPUs, 16 GB). Use with: -profile ci
// The production requests in nextflow.config (32 CPUs, 384 GB and more) exceed a runner.
process {
    withName: '.*_process' {
        cpus          = 2
        memory        = '6 GB'
        maxForks      = 2
        maxRetries    = 0
        errorStrategy = 'terminate'
    }
}

// Run the container as the user who starts the workflow. The image's own user cannot write to the
// work folder on a runner ("touch: cannot touch '.command.trace': Permission denied").
// That user has no home folder, so the places where libraries keep caches are set explicitly:
// numba (used by scanpy) stops with "cannot cache function ...: no locator available" when it
// finds nowhere to write.
docker {
    runOptions = '--platform linux/amd64 --pull always -u $(id -u):$(id -g) -e HOME=/tmp -e NUMBA_CACHE_DIR=/tmp/numba_cache -e XDG_CACHE_HOME=/tmp/.cache -e MPLCONFIGDIR=/tmp/matplotlib'
}
