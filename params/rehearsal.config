// Rehearsal on a laptop: the whole workflow, the real images, a small file (see scripts/make_rehearsal_subsample.py
// and scripts/build_and_rehearse.sh, which runs all of it).
//
//   nextflow run main.nf -c params/rehearsal.config \
//       --datasets_csv params/neocortex_datasets.csv --organ neocortex \
//       --custom_h5ad /full/path/rehearsal_subsample.h5ad \
//       --nsforest_image ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:<tag or @sha256:digest> \
//       --outdir /full/path/rehearsal_out
//
// Same processes and same images as on Lifebit; only the machine sizes are lowered so that a laptop accepts them.
// The images are amd64, so on Apple Silicon they run emulated: slower, but the file is small.
// Docker Desktop's memory limit must be at least executor.memory below (Settings > Resources).

params {
    silhouette_chunk_cells    = 1000     // the small file still gives several silhouette_cells tasks
    silhouette_max_forks      = 2
    nsforest_max_forks        = 2
    batch_size                = 5
    strict_errors             = true
}

docker {
    enabled    = true
    runOptions = '--platform linux/amd64'
}

// the whole run may use this much at one time, so two tasks of 3 GB run together
executor {
    name   = 'local'
    cpus   = 8
    memory = '7 GB'
}

process {
    // a selector declared later wins over the earlier selectors of nextflow.config
    withName: '.*' {
        cpus          = 2
        memory        = '3 GB'
        maxRetries    = 0
        errorStrategy = 'terminate'
    }
}

timeline.enabled = false
dag.enabled      = false
