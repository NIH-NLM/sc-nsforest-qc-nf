manifest {
    name            = 'NIH-NLM/sc-nsforest-qc-nf'
    description     = 'Nextflow workflow for NSForest marker genes and silhouette scores of the datasets found by cellxgene-harvester-nf.'
    version         = '1.0.0'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.0'
}

timeline.enabled   = true
timeline.overwrite = true
trace.enabled      = true
trace.overwrite    = true
dag.enabled        = true
dag.overwrite      = true

params {
    // ---- the datasets ------------------------------------------------------
    harvester_csv      = null         // <organism>_<organ>_harvester_final.csv from cellxgene-harvester-nf, with reference, author_cell_type and embedding filled in by the curator
    harvester_json     = null         // <organism>_<organ>_harvester_final.json from the same run: the record of every dataset
    h5ad_dir           = null         // folder of the filtered h5ad files, for datasets whose filtered_h5ad_url is not https:// or s3://; null = relative to the CSV
    organ              = null         // the organ, for example 'kidney'
    uberon_json        = null         // from resolve-uberon (cellxgene-harvester)
    disease_json       = null         // from resolve-disease
    hsapdv_json        = null         // from resolve-hsapdv
    assay_json         = null         // from resolve-assay: only cells of these assays are kept

    // ---- filtering ---------------------------------------------------------
    min_cluster_size  = 5             // clusters with fewer cells are dropped
    filter_obs_column = ''            // optional: keep only the cells with filter_obs_value in this obs column
    filter_obs_value  = ''

    // ---- NSForest ----------------------------------------------------------
    batch_size            = 5         // clusters in one NSForest task
    n_trees               = 1000
    max_cells_per_cluster = 0         // 0 = no subsampling
    nsforest_seed         = 42
    nsforest_memory       = '1024 GB'

    // ---- where the results go ----------------------------------------------
    outdir       = 'results'
    publish_mode = 'copy'

    // ---- step 9: publish to a branch of a GitHub repository ----------------
    s3_h5ad_prefix   = null           // public S3 folder where the final filtered h5ad files will be, for example 's3://bucket/path'; written to s3_filtered_h5ad in the ETL JSON. null = the local file name (tests)
    github_token     = null           // null skips the publish step
    publish_repo     = 'NIH-NLM/cell-kn'
    publish_dest_dir = null
}

timeline.file      = "${params.outdir}/pipeline_timeline.html"
trace.file         = "${params.outdir}/pipeline_trace.txt"
dag.file           = "${params.outdir}/pipeline_dag.html"

docker {
    enabled    = true
    runOptions = '--platform linux/amd64 --pull always'
}

process {     
     withName: 'cluster_cid_mapping_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus      = 32
        memory    = '384 GB'
        maxForks  = 1
	    errorStrategy = 'ignore'
    }
     withName: 'cluster_stats_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus      = 8
        memory    = '384 GB'
        maxForks  = 7
	    errorStrategy = 'ignore'
    }
    withName: 'compute_silhouette_process' {
        container = 'ghcr.io/nih-nlm/scsilhouette:1.5'
        containerOptions = '--entrypoint ""'
        cpus = 32
        memory = '1024 GB'
        maxForks = 6
	    errorStrategy = { task.exitStatus in [2147483647, 137, 143, 104, 134, 139] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'compute_summary_stats_process' {
        container = 'ghcr.io/nih-nlm/scsilhouette:1.5'
        containerOptions = '--entrypoint ""'
        cpus = 2
        memory = '8 GB'
        maxForks = 1
    }
    withName: 'dendrogram_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus = 8
        memory = '384 GB'
        maxForks = 7
    }
    withName: 'download_h5ad_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus = 2
        memory = '8 GB'
        maxForks = 1
    }
    withName: 'filter_adata_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus = 32
        memory = '1024 GB'
        maxForks = 6
	    errorStrategy = { task.exitStatus in [2147483647, 137, 143, 104, 134, 139] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'binary_positive_genes_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus      = 4
        memory    = '32 GB'
        maxForks  = 7
    }
    withName: 'build_etl_json_process' {
        container     = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus          = 1
        memory        = '2 GB'
        maxForks      = 1
    }
    withName: 'generate_s3_manifest_process' {
        container     = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus          = 2
        memory        = '8 GB'
        maxForks      = 1
        errorStrategy = 'ignore'
    }
    withName: 'merge_nsforest_results_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus = 8
        memory = '384 GB'
        maxForks = 7
	    errorStrategy = 'ignore'
    }
    withName: 'plot_histograms_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus = 8
        memory = '32 GB'
        maxForks = 7
	errorStrategy = 'ignore'
    }
    withName: 'plots_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus = 16
        memory = '512 GB'
        maxForks = 7
	    errorStrategy = 'ignore'
    }
    withName: 'prep_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus = 32
        memory = '1024 GB'
        maxForks = 6
	    errorStrategy = { task.exitStatus in [2147483647, 137, 143, 104, 134, 139] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'prep_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus = 32
        memory = '1024 GB'
        maxForks = 6
    }
    // we will set maxForks to 1 for the publish process - so that sequential publishing does not cause any conflicts
    withName: 'publish_results_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus          = 16
        memory        = '32 GB'
        maxForks      = 1
        errorStrategy = 'ignore'
    }
    withName: 'run_nsforest_process' {
        container = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:latest'
        cpus = 32
        memory = '512 GB'
        maxForks = 12
	errorStrategy = { task.exitStatus in [2147483647, 137, 143, 104, 134, 139] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    
    withName: 'viz_2D_projection_process' {
        container = 'ghcr.io/nih-nlm/scsilhouette:1.5'
        containerOptions = '--entrypoint ""'
        cpus = 32
        memory = '384 GB'
        maxForks = 6
	    errorStrategy = 'ignore'
    }
    withName: 'viz_distribution_process' {
        container = 'ghcr.io/nih-nlm/scsilhouette:1.5'
        containerOptions = '--entrypoint ""'
        cpus = 8
        memory = '32 GB'
        maxForks = 7
    }
    withName: 'viz_summary_process' {
        container = 'ghcr.io/nih-nlm/scsilhouette:1.5'
        containerOptions = '--entrypoint ""'
        cpus = 8
        memory = '32 GB'
        maxForks = 7
    }
}

profiles {
    // limits for a GitHub Actions runner (4 CPUs, 16 GB); the production requests are far larger
    ci {
        includeConfig 'configs/ci.config'
    }
}
