timeline.enabled   = true
timeline.overwrite = true
trace.enabled      = true
trace.overwrite    = true
dag.enabled        = true
dag.overwrite      = true

params {
    github_token     = null
    batch_size       = 5
    datasets_csv     = null
    organ            = null
    uberon_json      = null
    disease_json     = null
    hsapdv_json      = null
    min_cluster_size = 5
    outdir           = 'results'
    publish_mode     = 'copy'
    publish_repo     = 'NIH-NLM/cell-kn'
    publish_dest_dir = null
    n_trees               = 1000
    max_cells_per_cluster = 0
    nsforest_seed         = 42
    nsforest_memory       = '512 GB'
    filter_adata_memory   = '1024 GB'
    prep_memory           = '1024 GB'
    dendrogram_memory     = '384 GB'
    plots_memory          = '512 GB'
    // images: change them here, or with --nsforest_image / --scsilhouette_image, when a new image is built
    nsforest_image        = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:4c380184b7a60bbc7f26938b737130953a5b5982'
    scsilhouette_image    = 'ghcr.io/nih-nlm/scsilhouette:v1.0'
    // silhouette spread over tasks (modules/scsilhouette/silhouette_scatter.nf); only obs and the embedding are read (not X)
    silhouette_chunk_cells    = 50000   // cells scored in each task (neocortex 73k -> 2 tasks; retina 3.2M -> 65 tasks)
    silhouette_cells_cpus     = 4
    silhouette_cells_memory   = '16 GB'
    silhouette_max_forks      = 64      // silhouette_cells tasks that run at the same time
    silhouette_inputs_memory  = '32 GB'
    silhouette_summary_memory = '32 GB'
    nsforest_max_forks    = 12
    strict_errors         = true    // true: a failing science step stops the run (they used to ignore errors and show a green tick)
}

timeline.file      = "${params.outdir}/pipeline_timeline.html"
trace.file         = "${params.outdir}/pipeline_trace.txt"
dag.file           = "${params.outdir}/pipeline_dag.html"

docker {
    enabled    = true
    runOptions = '--platform linux/amd64 --pull always'
}

process {     
     withName: 'cluster_cid_mapping_process' {
        container = params.nsforest_image
        cpus      = 32
        memory    = '384 GB'
        maxForks  = 1
	    errorStrategy = params.strict_errors ? 'terminate' : 'ignore'
    }
     withName: 'cluster_stats_process' {
        container = params.nsforest_image
        cpus      = 8
        memory    = '384 GB'
        maxForks  = 7
	    errorStrategy = params.strict_errors ? 'terminate' : 'ignore'
    }
    withName: 'compute_silhouette_process' {
        container = params.scsilhouette_image
        containerOptions = '--entrypoint ""'
        cpus = 32
        memory = '1024 GB'
        maxForks = 6
	    errorStrategy = { task.exitStatus in [2147483647, 137, 143, 104, 134, 139] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'silhouette_inputs_process' {
        container = params.scsilhouette_image
        containerOptions = '--entrypoint ""'
        cpus = 2
        memory = params.silhouette_inputs_memory
        maxForks = 6
	    errorStrategy = { task.exitStatus in [2147483647, 137, 143, 104, 134, 139] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'silhouette_cells_process' {
        container = params.scsilhouette_image
        containerOptions = '--entrypoint ""'
        cpus = params.silhouette_cells_cpus
        memory = params.silhouette_cells_memory
        maxForks = params.silhouette_max_forks
	    errorStrategy = { task.exitStatus in [2147483647, 137, 143, 104, 134, 139] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    withName: 'silhouette_summary_process' {
        container = params.scsilhouette_image
        containerOptions = '--entrypoint ""'
        cpus = 2
        memory = params.silhouette_summary_memory
        maxForks = 6
	    errorStrategy = { task.exitStatus in [2147483647, 137, 143, 104, 134, 139] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'compute_summary_stats_process' {
        container = params.scsilhouette_image
        containerOptions = '--entrypoint ""'
        cpus = 2
        memory = '8 GB'
        maxForks = 1
    }
    withName: 'dendrogram_process' {
        container = params.nsforest_image
        cpus = 8
        memory = params.dendrogram_memory
        maxForks = 7
    }
    withName: 'download_h5ad_process' {
        container = params.nsforest_image
        cpus = 2
        memory = '8 GB'
        maxForks = 1
    }
    withName: 'filter_adata_process' {
        container = params.nsforest_image
        cpus = 32
        memory = params.filter_adata_memory
        maxForks = 6
	    errorStrategy = { task.exitStatus in [2147483647, 137, 143, 104, 134, 139] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'generate_s3_manifest_process' {
        container     = 'ghcr.io/nih-nlm/sc-nsforest-qc-nf/nsforest:4c380184b7a60bbc7f26938b737130953a5b5982'
        cpus          = 2
        memory        = '8 GB'
        maxForks      = 1
        errorStrategy = 'ignore'
    }
    withName: 'merge_nsforest_results_process' {
        container = params.nsforest_image
        cpus = 8
        memory = '384 GB'
        maxForks = 7
	    errorStrategy = params.strict_errors ? 'terminate' : 'ignore'
    }
    withName: 'plot_histograms_process' {
        container = params.nsforest_image
        cpus = 8
        memory = '32 GB'
        maxForks = 7
	errorStrategy = params.strict_errors ? 'terminate' : 'ignore'
    }
    withName: 'plots_process' {
        container = params.nsforest_image
        cpus = 16
        memory = params.plots_memory
        maxForks = 7
	    errorStrategy = params.strict_errors ? 'terminate' : 'ignore'
    }
    withName: 'prep_process' {
        container = params.nsforest_image
        cpus = 32
        memory = params.prep_memory
        maxForks = 6
	    errorStrategy = { task.exitStatus in [2147483647, 137, 143, 104, 134, 139] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'prep_process' {
        container = params.nsforest_image
        cpus = 32
        memory = params.prep_memory
        maxForks = 6
    }
    // we will set maxForks to 1 for the publish process - so that sequential publishing does not cause any conflicts
    withName: 'publish_results_process' {
        container = params.nsforest_image
        cpus          = 16
        memory        = '32 GB'
        maxForks      = 1
        errorStrategy = 'ignore'
    }
    withName: 'run_nsforest_process' {
        container = params.nsforest_image
        cpus = 32
        memory = params.nsforest_memory
        maxForks = params.nsforest_max_forks
	errorStrategy = { task.exitStatus in [2147483647, 137, 143, 104, 134, 139] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    
    withName: 'viz_2D_projection_process' {
        container = params.scsilhouette_image
        containerOptions = '--entrypoint ""'
        cpus = 32
        memory = '384 GB'
        maxForks = 6
	    errorStrategy = params.strict_errors ? 'terminate' : 'ignore'
    }
    withName: 'viz_distribution_process' {
        container = params.scsilhouette_image
        containerOptions = '--entrypoint ""'
        cpus = 8
        memory = '32 GB'
        maxForks = 7
    }
    withName: 'viz_summary_process' {
        container = params.scsilhouette_image
        containerOptions = '--entrypoint ""'
        cpus = 8
        memory = '32 GB'
        maxForks = 7
    }
}
